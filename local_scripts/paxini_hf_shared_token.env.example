# Copy this file to local_scripts/paxini_hf_shared_token.env before collection.
# Do not paste the Hugging Face token into this file.
#
# Token workflow:
# 1. Receive the temporary fine-grained Hugging Face token from the dataset owner.
# 2. In the terminal, run one of:
#      export HF_TOKEN='paste-token-here'
#      .venv/bin/hf auth login
# 3. Never commit or paste the token into GitHub or Notion.
# 4. The owner should revoke/delete the temporary token after collection.

HF_NAMESPACE=jhyeong687
DATASET_PRIVATE=true
SYNC_FROM_HUB=true
UPLOAD_TO_HUB=true
